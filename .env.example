# Optional environment overrides. The primary configuration lives in
# ~/.config/durable-chat/config.yaml (see `durable-chat config show`).
# Folder overrides: .durable-chat/config.yaml in the launch folder.
# Precedence: CLI flag > environment variable > local config > global config > built-in.
#
# Point at a standalone YAML file (bypasses automatic global/local layering):
# DURABLE_CHAT_CONFIG=~/.config/durable-chat/config.yaml

# Offline faux model
# DURABLE_PROVIDER=faux
# A configured provider entry name also works: DURABLE_PROVIDER=local

# Local OpenAI-compatible server (also the generated config's defaults)
# DURABLE_PROVIDER=local
# DURABLE_BASE_URL=http://127.0.0.1:1234/v1
# DURABLE_MODEL_ID=nemotron-bolt
# DURABLE_CONTEXT_WINDOW=262144
# DURABLE_MAX_TOKENS=32768
# DURABLE_STREAM_TIMEOUT_MS=600000

# OpenAI ChatGPT/Codex subscription (OAuth credentials from pi)
# DURABLE_PROVIDER=openai-codex
# DURABLE_MODEL_ID=gpt-6.1-sol
# DURABLE_THINKING_LEVEL=medium
# DURABLE_CONTEXT_WINDOW=500000
# DURABLE_MAX_TOKENS=128000
# DURABLE_AUTH_FILE=~/.pi/agent/auth.json

# OpenAI API key
# DURABLE_PROVIDER=openai
# DURABLE_MODEL_ID=<listed model id>
# OPENAI_API_KEY=...

# Store and behavior
# DURABLE_STORE=~/.local/share/durable-chat/store.sqlite
# DURABLE_RETRIES=1
# DURABLE_THINKING_LEVEL=medium
# DURABLE_MAX_TURNS=60
# DURABLE_JOB_MAX_TURNS=120
# Automatically continue main with a follow-up input when a job finishes.
# DURABLE_AUTO_CONTINUE=true

# QuickJS scripts that call the conversation's tools; only the script's output comes back.
# DURABLE_CODEMODE=true

# MCP
# DURABLE_MCP_ENABLED=true
# DURABLE_MCP_SERVERS=substrate
# DURABLE_MCP_TOOLS=
# DURABLE_MCP_CONFIG=~/.pi/agent/mcp.json
